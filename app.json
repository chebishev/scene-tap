{
  "configVersion": "v3",
  "app": {
    "appId": 21008,
    "appName": "Scene Tap",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "chebishev",
    "description": "Use MijiaAPI to control your Mi Home Devices"
  },
  "permissions": [
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.2"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index", "page/scenes", "page/devices", "page/login", "page/about"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Scene Tap"
    }
  },
  "defaultLanguage": "en-US"
}
